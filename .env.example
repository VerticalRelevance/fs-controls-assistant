# Copy to .env and fill in. Do not commit .env.

# AWS CLI profile for the VR-approved training account (not a client account)
AWS_PROFILE=vr-training
AWS_REGION=us-east-1

# Two models to compare. The VR org SCP allows only some models (tested 2026-11-19, us-east-1):
#   allowed: us.anthropic.claude-sonnet-5, -sonnet-4-6, -sonnet-4-5-*, -haiku-4-5-*,
#            us.amazon.nova-micro/lite/2-lite, amazon.titan-embed-text-v2:0
#   blocked: all global.* profiles, Opus, Haiku 5.5, Sonnet 5.5, Nova Pro, Llama, Mistral, OpenAI
MODEL_ID_A=us.anthropic.claude-sonnet-5
MODEL_ID_B=us.amazon.nova-2-lite-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Filled in later in the module
KNOWLEDGE_BASE_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=
